# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model and comma-separated fallbacks used when the primary is rate-limited or unavailable
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# MongoDB connection string (Atlas free tier works)
MONGODB_URI=

# Secret used to sign session cookies - any long random string
SESSION_SECRET=

# Port the API + served client listens on
PORT=8787

# Allow the crawler to fetch private/loopback addresses (needed for local evaluation
# fixtures like http://localhost:8099/acme/). Keep false in production.
ALLOW_PRIVATE_ADDRESSES=true

# Browser origin allowed during development (Vite dev server); not used in production
# where the client is served by the API itself.
CLIENT_ORIGIN=http://localhost:5173
